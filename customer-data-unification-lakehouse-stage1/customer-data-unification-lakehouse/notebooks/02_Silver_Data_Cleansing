# Start with the raw Bronze transaction DataFrame.
silver_transactions_df = bronze_transactions_df

# Standardise the transaction ID by trimming whitespace and converting it to uppercase.
silver_transactions_df = silver_transactions_df.withColumn(
    "transaction_id",
    F.upper(clean_text("transaction_id"))
)
# Standardise the customer ID to match the customer dimension format.
silver_transactions_df = silver_transactions_df.withColumn(
    "customer_id",
