# Define a reusable function to calculate valid and invalid record counts for any Silver DataFrame.
def display_quality_summary(dataframe, dataset_name):
    # Count records marked as valid.
    valid_count = dataframe.filter(
        F.col("_is_valid") == True
    ).count()
    # Count records marked as invalid.
    invalid_count = dataframe.filter(
        F.col("_is_valid") == False
    ).count()
    # Print the quality summary for the dataset.
    print(f"\nDataset: {dataset_name}")
    print(f"Valid records: {valid_count}")
    print(f"Invalid records: {invalid_count}")
    print(f"Total records: {valid_count + invalid_count}")

# Calculate the customer quality summary.
display_quality_summary(
    silver_customers_df,
    "Customers"
)

# Calculate the transaction quality summary.
display_quality_summary(
    silver_transactions_df,
    "Transactions"
)

# Calculate the contact quality summary.
display_quality_summary(
    silver_contacts_df,
    "Contacts"
)
