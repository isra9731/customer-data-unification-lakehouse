# Build a single quality issue column for customer records. concat_ws combines all detected issues into a readable string.
silver_customers_df = silver_customers_df.withColumn(
    "_quality_issues",
    F.concat_ws(
        "; ",

        # Customer ID is mandatory.
        F.when(
            F.col("customer_id").isNull(),
            F.lit("MISSING_CUSTOMER_ID")
        ),

        # Full name is mandatory.
        F.when(
            F.col("full_name").isNull(),
            F.lit("MISSING_CUSTOMER_NAME")
        ),

        # Validate email format when an email is provided.
        F.when(
            F.col("email").isNotNull()
            & ~F.col("email").rlike(
                r"^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$"
            ),
            F.lit("INVALID_EMAIL")
        ),

        # Identify DOB values that were supplied but could not be converted into a valid date.
        F.when(
            F.col("date_of_birth").isNull()
            & F.col("date_of_birth").isNull(),
            F.lit(None)
        )
    )
)

# Add a separate flag to identify future birth dates.
silver_customers_df = silver_customers_df.withColumn(
    "_quality_issues",
    F.concat_ws(
        "; ",
        F.col("_quality_issues"),
        F.when(
            F.col("date_of_birth") > F.current_date(),
            F.lit("FUTURE_DATE_OF_BIRTH")
        )
    )
)

# Mark records with no detected issues as valid. Records with one or more issues are marked invalid.
silver_customers_df = silver_customers_df.withColumn(
    "_is_valid",
    F.when(
        F.length(F.col("_quality_issues")) == 0,
        F.lit(True)
    ).otherwise(F.lit(False))
)

# Display customer records with their quality indicators.
display(
    silver_customers_df.select(
        "customer_id",
        "full_name",
        "email",
        "date_of_birth",
        "_quality_issues",
        "_is_valid"
    )
)

# Add a quality issue column for transaction records.
silver_transactions_df = silver_transactions_df.withColumn(
    "_quality_issues",
    F.concat_ws(
        "; ",

        # Transaction ID is mandatory.
        F.when(
            F.col("transaction_id").isNull(),
            F.lit("MISSING_TRANSACTION_ID")
        ),

        # Customer ID is mandatory.
        F.when(
            F.col("customer_id").isNull(),
            F.lit("MISSING_CUSTOMER_ID")
        ),

        # Transaction date is mandatory.
        F.when(
            F.col("transaction_date").isNull(),
            F.lit("INVALID_OR_MISSING_TRANSACTION_DATE")
        ),

        # Amount must be available and convertible to decimal.
        F.when(
            F.col("amount").isNull(),
            F.lit("INVALID_OR_MISSING_AMOUNT")
        ),

        # Currency is mandatory.
        F.when(
            F.col("currency").isNull(),
            F.lit("MISSING_CURRENCY")
        ),

        # Channel is mandatory.
        F.when(
            F.col("channel").isNull(),
            F.lit("MISSING_CHANNEL")
        )
    )
)

# Mark a transaction as valid only when no quality issues exist.
silver_transactions_df = silver_transactions_df.withColumn(
    "_is_valid",
    F.when(
        F.length(F.col("_quality_issues")) == 0,
        F.lit(True)
    ).otherwise(F.lit(False))
)

# Display transaction records with their quality indicators.
display(
    silver_transactions_df.select(
        "transaction_id",
        "customer_id",
        "transaction_date",
        "amount",
        "currency",
        "_quality_issues",
        "_is_valid"
    )
)

# Add a quality issue column for contact records.
silver_contacts_df = silver_contacts_df.withColumn(
    "_quality_issues",
    F.concat_ws(
        "; ",

        # Contact ID is mandatory.
        F.when(
            F.col("contact_id").isNull(),
            F.lit("MISSING_CONTACT_ID")
        ),

        # Contact name is mandatory for identity matching.
        F.when(
            F.col("full_name").isNull(),
            F.lit("MISSING_CONTACT_NAME")
        ),

        # Validate email format when an email is supplied.
        F.when(
            F.col("email").isNotNull()
            & ~F.col("email").rlike(
                r"^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$"
            ),
            F.lit("INVALID_CONTACT_EMAIL")
        ),

        # Source system is required to track contact provenance.
        F.when(
            F.col("source_system").isNull(),
            F.lit("MISSING_SOURCE_SYSTEM")
        )
    )
)

# Mark contacts as valid when no quality issues are detected.
silver_contacts_df = silver_contacts_df.withColumn(
    "_is_valid",
    F.when(
        F.length(F.col("_quality_issues")) == 0,
        F.lit(True)
    ).otherwise(F.lit(False))
)

# Display contact records with their quality indicators.
display(
    silver_contacts_df.select(
        "contact_id",
        "full_name",
        "email",
        "phone",
        "source_system",
        "_quality_issues",
        "_is_valid"
    )
)

# Define a window partitioned by customer ID. Records for the same customer are ranked together.
customer_window = (
    Window
    .partitionBy("customer_id")
    .orderBy(
        F.col("updated_at").desc_nulls_last(),
        F.col("_ingested_at").desc_nulls_last()
    )
)

# Assign a row number to each customer record. The latest record receives rank 1.
customers_ranked_df = silver_customers_df.withColumn(
    "_duplicate_rank",
    F.row_number().over(customer_window)
)

# Count how many duplicate records will be removed. This is calculated before filtering the ranked DataFrame.
customer_duplicate_count = (
    customers_ranked_df
    .filter(F.col("_duplicate_rank") > 1)
    .count()
)

# Retain only the latest record for each customer ID. Remove the temporary ranking column afterwards.
silver_customers_df = (
    customers_ranked_df
    .filter(F.col("_duplicate_rank") == 1)
    .drop("_duplicate_rank")
)

# Display the number of duplicate customer records identified.
print("Duplicate customer records removed:", customer_duplicate_count)

# Define a window partitioned by transaction ID. The most recently ingested version is retained.
transaction_window = (
    Window
    .partitionBy("transaction_id")
    .orderBy(
        F.col("_ingested_at").desc_nulls_last()
    )
)

# Rank transaction records within each transaction ID.
transactions_ranked_df = silver_transactions_df.withColumn(
    "_duplicate_rank",
    F.row_number().over(transaction_window)
)

# Count duplicate transaction records before removing them.
transaction_duplicate_count = (
    transactions_ranked_df
    .filter(F.col("_duplicate_rank") > 1)
    .count()
)

# Retain the latest record for each transaction ID.
silver_transactions_df = (
    transactions_ranked_df
    .filter(F.col("_duplicate_rank") == 1)
    .drop("_duplicate_rank")
)

# Display the duplicate transaction count.
print("Duplicate transaction records removed:", transaction_duplicate_count)

# Define a window partitioned by contact ID. The most recently ingested contact record is retained.
contact_window = (
    Window
    .partitionBy("contact_id")
    .orderBy(
        F.col("_ingested_at").desc_nulls_last()
    )
)

# Rank all contact records within their respective contact IDs.
contacts_ranked_df = silver_contacts_df.withColumn(
    "_duplicate_rank",
    F.row_number().over(contact_window)
)

# Count duplicate contact records before filtering.
contact_duplicate_count = (
    contacts_ranked_df
    .filter(F.col("_duplicate_rank") > 1)
    .count()
)

# Keep only the latest contact record for each contact ID.
silver_contacts_df = (
    contacts_ranked_df
    .filter(F.col("_duplicate_rank") == 1)
    .drop("_duplicate_rank")
)

# Display the number of duplicate contact records removed.
print("Duplicate contact records removed:", contact_duplicate_count)

# Ensure that the Silver schema exists before writing tables. This allows the notebook to be executed independently after the Bronze layer has been created.
spark.sql(
