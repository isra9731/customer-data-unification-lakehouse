# Define a function to remove leading/trailing spaces and convert empty strings into NULL values.
def clean_text(column_name):
    return F.when(
        F.trim(F.col(column_name)) == "",
        F.lit(None)
    ).otherwise(
        F.trim(F.col(column_name))
    )

# Define a function to standardise person names. # It removes unnecessary whitespace and applies title casing.
def standardise_name(column_name):
    return F.initcap(
        F.regexp_replace(
            F.trim(F.col(column_name)),
            r"\s+",
            " "
        )
    )

# Define a function to standardise email addresses. Emails are trimmed and converted to lowercase.
def standardise_email(column_name):
    return F.lower(
        F.trim(F.col(column_name))
    )

# Define a function to standardise phone numbers. It removes spaces, brackets, hyphens and other non-numeric characters while preserving a leading plus sign.
def standardise_phone(column_name):
    return F.regexp_replace(
        F.trim(F.col(column_name)),
        r"[^0-9+]",
        ""
    )

# Define a reusable function to convert date strings safely. Invalid date values become NULL instead of stopping processing.
def safe_date(column_name):
    return F.expr(
        f"try_cast(`{column_name}` AS DATE)"
    )

# Define a reusable function to convert timestamp strings safely. Invalid timestamp values become NULL instead of causing failures.
def safe_timestamp(column_name):
    return F.expr(
        f"try_cast(`{column_name}` AS TIMESTAMP)"
    )


# Start with the raw Bronze customer DataFrame. All transformations are applied to a new DataFrame, leaving the original Bronze table unchanged.
silver_customers_df = bronze_customers_df
silver_customers_df = silver_customers_df.withColumn( # Standardise the customer ID by trimming whitespace and converting it to uppercase.
    "customer_id",
    F.upper(clean_text("customer_id"))
)
silver_customers_df = silver_customers_df.withColumn( # Standardise the customer's full name. Extra spaces are removed and names are converted to title case.
    "full_name",
    standardise_name("full_name")
)
silver_customers_df = silver_customers_df.withColumn( # Standardise email addresses by trimming spaces and converting all characters to lowercase.
    "email",
    standardise_email("email")
)
silver_customers_df = silver_customers_df.withColumn( # Standardise phone numbers by removing formatting characters.
    "phone",
    standardise_phone("phone")
)
silver_customers_df = silver_customers_df.withColumn( # Standardise city names into title case.
    "city",
    standardise_name("city")
)
silver_customers_df = silver_customers_df.withColumn( # Standardise state names into uppercase.
    "state",
    F.upper(clean_text("state"))
)
silver_customers_df = silver_customers_df.withColumn( # Convert date_of_birth from a string into a DATE data type. Invalid date strings will become NULL.
    "date_of_birth",
    safe_date("date_of_birth")
)
# Convert created_at into a TIMESTAMP data type. This enables proper timestamp-based filtering and comparisons.
silver_customers_df = silver_customers_df.withColumn(
    "created_at",
    safe_timestamp("created_at")
)
# Convert updated_at into a TIMESTAMP data type. This field will later help us identify the latest customer version.
silver_customers_df = silver_customers_df.withColumn(
    "updated_at",
    safe_timestamp("updated_at")
)
# Add a processing timestamp to identify when the record passed through the Silver transformation.
